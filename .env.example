# Copy to .env and fill in. .env is git-ignored.
GEMINI_API_KEY=your-gemini-api-key-here
# Gemini's OpenAI-compatible endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Tried automatically when the main model is overloaded (503) or keeps failing. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Requested with dimensions=1536 to match the Qdrant collection
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Port and URL overrides
N8N_HOST_PORT=5678
POSTGRES_HOST_PORT=5432
QDRANT_HOST_PORT=6333
WEBHOOK_URL=http://localhost:5678/

# Recommended. When set, POST /webhook/support-message must send the header  X-API-Key: <this value>.
# Without it anyone who can reach the webhook can trigger AI calls and emails. Generate one with:
#   [guid]::NewGuid().ToString('N')
SUPPORT_API_KEY=

# Database password. Only applied when the Postgres volume is first created; the default is for local use only.
POSTGRES_PASSWORD=support123

# Email (optional). Without SMTP the email nodes fail softly and the rest of the workflow still runs.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@example.com
SUPPORT_ALERT_EMAIL=support-team@example.com
